generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model customers {
  id             Int              @id @default(autoincrement())
  type           String?          @db.VarChar(30)
  name           String           @db.VarChar(200)
  gst_no         String?          @db.VarChar(20)
  state          String?          @db.VarChar(100)
  city           String?          @db.VarChar(100)
  address        String?
  phone          String?          @db.VarChar(20)
  email          String?          @db.VarChar(150)
  credit_limit   Decimal?         @default(0) @db.Decimal(12, 2)
  outstanding    Decimal?         @default(0) @db.Decimal(12, 2)
  is_active      Boolean?         @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  invoices       invoices[]
  payments       payments[]
  sales_orders   sales_orders[]
  service_jobs   service_jobs[]
  warranty_cards warranty_cards[]
}

model grn {
  id              Int              @id @default(autoincrement())
  grn_number      String?          @unique @db.VarChar(50)
  po_id           Int?
  vendor_id       Int?
  warehouse_id    Int?
  received_date   DateTime?        @db.Date
  status          String?          @db.VarChar(20)
  created_by      Int?
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  users           users?           @relation("grn_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders purchase_orders? @relation(fields: [po_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendors         vendors?         @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses      warehouses?      @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grn_items       grn_items[]
}

model grn_items {
  id             Int       @id @default(autoincrement())
  grn_id         Int?
  product_id     Int?
  qty_received   Int?
  batch_no       String?   @db.VarChar(120)
  serial_numbers String[]
  grn            grn?      @relation(fields: [grn_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products       products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model inventory_movements {
  id           Int         @id @default(autoincrement())
  product_id   Int?
  warehouse_id Int?
  ref_type     String?     @db.VarChar(30)
  ref_id       Int?
  qty_change   Int?
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  products     products?   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses   warehouses? @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model inventory_stock {
  id            Int         @id @default(autoincrement())
  product_id    Int?
  warehouse_id  Int?
  on_hand_qty   Int?        @default(0)
  reserved_qty  Int?        @default(0)
  available_qty Int?        @default(0)
  last_updated  DateTime?   @default(now()) @db.Timestamp(6)
  products      products?   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses    warehouses? @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([product_id, warehouse_id])
  @@index([product_id, warehouse_id], map: "idx_inventory_product_warehouse")
}

model invoice_items {
  id            Int       @id @default(autoincrement())
  invoice_id    Int?
  product_id    Int?
  qty           Int?
  price         Decimal?  @db.Decimal(12, 2)
  gst_percent   Int?
  taxable_value Decimal?  @db.Decimal(12, 2)
  gst_value     Decimal?  @db.Decimal(12, 2)
  invoices      invoices? @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products      products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model invoices {
  id                   Int              @id @default(autoincrement())
  invoice_number       String?          @unique(map: "idx_invoice_number") @db.VarChar(50)
  so_id                Int?
  customer_id          Int?
  warehouse_id         Int?
  invoice_date         DateTime?        @db.Date
  total_taxable        Decimal?         @db.Decimal(12, 2)
  total_gst            Decimal?         @db.Decimal(12, 2)
  total_invoice_amount Decimal?         @db.Decimal(12, 2)
  payment_status       String?          @db.VarChar(20)
  transport_id         Int?
  created_by           Int?
  created_at           DateTime?        @default(now()) @db.Timestamp(6)
  invoice_items        invoice_items[]
  users                users?           @relation("invoice_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers            customers?       @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_orders         sales_orders?    @relation(fields: [so_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses           warehouses?      @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments             payments[]
  transport            transport[]
  warranty_cards       warranty_cards[]
}

model payments {
  id            Int        @id @default(autoincrement())
  customer_id   Int?
  invoice_id    Int?
  mode          String?    @db.VarChar(20)
  amount        Decimal?   @db.Decimal(12, 2)
  received_date DateTime?  @db.Date
  reference_no  String?    @db.VarChar(120)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  customers     customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices      invoices?  @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model product_batches {
  id                Int       @id @default(autoincrement())
  product_id        Int?
  batch_no          String?   @db.VarChar(120)
  mfg_date          DateTime? @db.Date
  exp_warranty_date DateTime? @db.Date
  purchase_cost     Decimal?  @db.Decimal(12, 2)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  products          products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model products {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(200)
  model                String                 @unique(map: "idx_products_model") @db.VarChar(120)
  brand                String?                @db.VarChar(120)
  category             String?                @db.VarChar(120)
  power_hp             Decimal?               @db.Decimal(5, 2)
  phase                String?                @db.VarChar(20)
  hsn                  String?                @db.VarChar(20)
  gst                  Int?
  warranty_months      Int?                   @default(12)
  unit                 String?                @default("Nos") @db.VarChar(10)
  mrp                  Decimal?               @db.Decimal(12, 2)
  dealer_price         Decimal?               @db.Decimal(12, 2)
  distributor_price    Decimal?               @db.Decimal(12, 2)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  grn_items            grn_items[]
  inventory_movements  inventory_movements[]
  inventory_stock      inventory_stock[]
  invoice_items        invoice_items[]
  product_batches      product_batches[]
  purchase_order_items purchase_order_items[]
  sales_order_items    sales_order_items[]
  service_jobs         service_jobs[]
  warranty_cards       warranty_cards[]
}

model purchase_order_items {
  id              Int              @id @default(autoincrement())
  po_id           Int?
  product_id      Int?
  qty             Int?
  rate            Decimal?         @db.Decimal(12, 2)
  gst_percent     Int?
  amount          Decimal?         @db.Decimal(12, 2)
  purchase_orders purchase_orders? @relation(fields: [po_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products        products?        @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model purchase_orders {
  id                   Int                    @id @default(autoincrement())
  po_number            String?                @unique(map: "idx_po_number") @db.VarChar(50)
  vendor_id            Int?
  warehouse_id         Int?
  order_date           DateTime?              @db.Date
  status               String?                @db.VarChar(30)
  total_amount         Decimal?               @db.Decimal(12, 2)
  remarks              String?
  created_by           Int?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  grn                  grn[]
  purchase_order_items purchase_order_items[]
  users                users?                 @relation("po_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendors              vendors?               @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses           warehouses?            @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model roles {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  permissions Json?     @default("[]")
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users[]
}

model sales_order_items {
  id           Int           @id @default(autoincrement())
  so_id        Int?
  product_id   Int?
  qty          Int?
  price        Decimal?      @db.Decimal(12, 2)
  gst_percent  Int?
  amount       Decimal?      @db.Decimal(12, 2)
  products     products?     @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_orders sales_orders? @relation(fields: [so_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sales_orders {
  id                Int                 @id @default(autoincrement())
  so_number         String?             @unique(map: "idx_so_number") @db.VarChar(50)
  customer_id       Int?
  warehouse_id      Int?
  order_date        DateTime?           @db.Date
  status            String?             @db.VarChar(30)
  total_amount      Decimal?            @db.Decimal(12, 2)
  created_by        Int?
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  invoices          invoices[]
  sales_order_items sales_order_items[]
  users             users?              @relation("so_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers         customers?          @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses        warehouses?         @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model service_jobs {
  id             Int        @id @default(autoincrement())
  job_no         String?    @unique @db.VarChar(50)
  serial_no      String?    @db.VarChar(120)
  product_id     Int?
  customer_id    Int?
  complaint_date DateTime?  @db.Date
  issue          String?
  status         String?    @db.VarChar(30)
  work_done      String?
  service_cost   Decimal?   @db.Decimal(12, 2)
  under_warranty Boolean?
  technician     String?    @db.VarChar(120)
  closed_date    DateTime?  @db.Date
  created_at     DateTime?  @default(now()) @db.Timestamp(6)
  customers      customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products       products?  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model transport {
  id               Int       @id @default(autoincrement())
  invoice_id       Int?
  transporter_name String?   @db.VarChar(200)
  lr_no            String?   @db.VarChar(100)
  vehicle_no       String?   @db.VarChar(50)
  dispatch_date    DateTime? @db.Date
  delivery_date    DateTime? @db.Date
  proof_url        String?
  invoices         invoices? @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id Int @id @default(autoincrement())

  name  String @db.VarChar(120)
  email String @unique @db.VarChar(120)

  // Auth fields
  password_hash String?
  google_id     String? @unique @db.VarChar(255)

  // ERP fields
  phone     String? @db.VarChar(20)
  role_id   Int
  is_active Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  // Role relation
  roles roles @relation(fields: [role_id], references: [id])

  // ERP relations (audit trail)
  grn             grn[]             @relation("grn_created_by")
  invoices        invoices[]        @relation("invoice_created_by")
  purchase_orders purchase_orders[] @relation("po_created_by")
  sales_orders    sales_orders[]    @relation("so_created_by")
  audit_logs      audit_logs[]      @relation("UserAuditLogs")

  // Auth.js relations
  accounts Account[]
  sessions Session[]
}

model vendors {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(200)
  gst_no          String?           @db.VarChar(20)
  address         String?
  state           String?           @db.VarChar(100)
  city            String?           @db.VarChar(100)
  phone           String?           @db.VarChar(20)
  email           String?           @db.VarChar(150)
  payment_terms   String?           @db.VarChar(100)
  is_active       Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  grn             grn[]
  purchase_orders purchase_orders[]
}

model warehouses {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(150)
  state               String?               @db.VarChar(100)
  city                String?               @db.VarChar(100)
  address             String?
  contact_person      String?               @db.VarChar(120)
  phone               String?               @db.VarChar(20)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  grn                 grn[]
  inventory_movements inventory_movements[]
  inventory_stock     inventory_stock[]
  invoices            invoices[]
  purchase_orders     purchase_orders[]
  sales_orders        sales_orders[]
}

model warranty_cards {
  id             Int        @id @default(autoincrement())
  product_id     Int?
  serial_no      String?    @unique(map: "idx_warranty_serial") @db.VarChar(120)
  customer_id    Int?
  invoice_id     Int?
  warranty_start DateTime?  @db.Date
  warranty_end   DateTime?  @db.Date
  status         String?    @db.VarChar(20)
  customers      customers? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices       invoices?  @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products       products?  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

//Prisma Models (Auth Tables)

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


//audit log
model audit_logs {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(50)
  entity      String   @db.VarChar(50)
  entity_id   Int?
  old_data    Json?
  new_data    Json?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?
  created_at  DateTime @default(now())

  users users? @relation("UserAuditLogs", fields: [user_id], references: [id])
}
